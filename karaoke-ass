#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export KARAOKE_WORKING_DIRECTORY="$PWD"
clojure_bin="${KARAOKE_CLOJURE:-clojure}"
if [[ "$clojure_bin" == */* && "$clojure_bin" != /* ]]; then
  clojure_bin="$PWD/$clojure_bin"
fi
if [[ -n "${KARAOKE_PYTHON:-}" && "$KARAOKE_PYTHON" == */* && "$KARAOKE_PYTHON" != /* ]]; then
  export KARAOKE_PYTHON="$PWD/$KARAOKE_PYTHON"
fi
cd "$project_dir"
exec "$clojure_bin" -Srepro -M:run "$@"
